# توکن ربات تلگرام (از BotFather بگیر: https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# شناسه عددی تلگرام خودت (فقط همین کاربر مجاز است). از @userinfobot بگیر.
ALLOWED_USER_IDS=

# آدرس سرور opencode serve
OPENCODE_BASE_URL=http://127.0.0.1:4199

# عامل پیش‌فرض (build | general | plan | ...)
OPENCODE_AGENT=build

# فایل ذخیره‌سازی session هر کاربر
STATE_FILE=state.json

# (اختیاری) برای قابلیت «تنظیمات» داخل ربات — اگر خالی بماند خودکار پیدا می‌شود:
# پوشه کانفیگ opencode (شامل opencode.json/.jsonc)
OPENCODE_CONFIG_HOME=
# پوشه دیتای opencode (شامل auth.json)
OPENCODE_DATA_HOME=
# نام سرویس systemd سرور opencode (برای ری‌استارت خودکار)
OPENCODE_SERVE_SERVICE=
