[Unit]
Description=OpenCode Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/negahban-opencode
EnvironmentFile=/root/negahban-opencode/.env
ExecStart=/root/negahban-opencode/negahban-opencode
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
