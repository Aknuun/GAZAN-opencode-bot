[Unit]
Description=OpenCode Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/opencode-tg-bot
EnvironmentFile=/root/opencode-tg-bot/.env
ExecStart=/root/opencode-tg-bot/opencode-tg-bot
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
